{
  "expo": {
    "name": "LME",
    "slug": "lme-mobile",
    "version": "0.1.0",
    "entryPoint": "./index.js",
    "sdkVersion": "54.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#080E09"
    },
    "android": {
      "package": "com.lme.rider"
    },
    "ios": {
      "bundleIdentifier": "com.lme.mobile"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#1A6B2E"
        }
      ]
    ]
  }
}