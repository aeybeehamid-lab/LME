PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lme
JWT_SECRET=replace-with-long-random-secret
# Paystack test secret from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_replace_me
# Where Paystack redirects after payment (admin web); mobile verifies via API
PAYSTACK_CALLBACK_URL=http://localhost:3000/orders
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
ORDER_AUTOMATION_INTERVAL_MS=60000

# Firebase (phone OTP) — see docs/FIREBASE_SETUP.md
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

