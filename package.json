{
  "name": "lme-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "pg": "^8.16.3"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "build:api": "npm run build -w apps/api",
    "build:dashboard": "npm run build -w apps/dashboard",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/dashboard",
    "db:migrate": "node infra/scripts/migrate.js"
  }
}

